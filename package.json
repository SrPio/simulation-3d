{
  "name": "simulation-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:browser": "node --test --test-concurrency=1 tests/viewer.browser.ts tests/home.browser.ts",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/fontkit": "^2.0.9",
    "@types/three": "0.185.4",
    "fontkit": "^2.0.4",
    "polygon-clipping": "^0.15.7",
    "typescript": "6.0.3",
    "vite": "8.2.2"
  }
}
